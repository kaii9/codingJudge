API_ADDR=:8080
WORKER_CONCURRENCY=1
JUDGE_LEASE_DURATION=30s
JUDGE_HEARTBEAT_INTERVAL=10s
JUDGE_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_GRACE=30s
EXECUTOR_URL=http://executor:8090
EXECUTOR_TOKEN=replace-with-a-long-random-secret
EXECUTOR_TIMEOUT=120s

# Executor service
EXECUTOR_ADDR=:8090
EXECUTOR_MAX_CONCURRENCY=2
EXECUTOR_SHUTDOWN_GRACE=30s
JUDGE_WORKDIR=/tmp/codingjudge-sandbox

# Optional. Leave empty to use per-language default images.
JUDGE_IMAGE=

# Worker metrics port. Set to "off" to disable.
WORKER_METRICS_ADDR=:9091

# Compose services
DATABASE_URL=postgres://codingjudge:codingjudge@postgres:5432/codingjudge?sslmode=disable
REDIS_ADDR=redis:6379
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=codingjudge-assets
MINIO_USE_SSL=false
COOKIE_SECURE=false
SUBMISSION_RATE_LIMIT_PER_MINUTE=10
SUBMISSION_RATE_LIMIT_BURST=3

# Monitoring
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASS=admin
